            "params": [
              {
                "name": "event_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns full information, including request and response bodies, for one event."
        },
