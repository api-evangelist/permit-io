  "item": [
    {
      "id": "c88cea4b-e4a2-4e4e-995d-2306fd030d4f",
      "name": "Projects",
      "description": {
        "content": "\nProjects let you manage permissions for different business objectives from a single Permit account.\n\nFor example, you can create one project called \"Billing App\" and another project called \"Web App\".\nEvery project is a separate silo, and has its own unique set of environments and policies.\n",
        "type": "text/plain"
      },
